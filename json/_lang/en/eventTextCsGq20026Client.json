{
  "88674": {
    "「お～い！！　ツィム！\n　お前が依頼した　<%sEV_SYOK_ITEM>が\n　届いたぞ～！！": ""
  },
  "88675": {
    "「……お久しぶりですね。\n　<pc>さん。": ""
  },
  "88676": {
    "「……あなたを指名し　仕事を依頼した理由は\n　じつは　防具のためではないんです。": ""
  },
  "88677": {
    "「信頼できる人から　姉の様子を聞きたくて\n　それで　こんなことを……。\n　申し訳ありません。": ""
  },
  "88678": {
    "「教えてください　<pc>さん。\n　姉は　まだ　命の炎を求めているんですか？": ""
  },
  "88679": {
    "「……<pc>さんの　命の炎が\n　姉には　どうしても必要だと？": ""
  },
  "88680": {
    "「もしかして　姉は　あなたの命を\n　狙っているのかもしれない！\n　急いで　止めなければ……。": ""
  },
  "88681": {
    "「うっ！": ""
  },
  "88682": {
    "「ツィム！　またいつもの発作か！？": ""
  },
  "88683": {
    "「こいつと俺は　この修道院で\n　いっしょに育ったんだが\n　こいつ　時々　奇妙な発作を起こすんだ。": ""
  },
  "88684": {
    "「……なんとか　おさまった。\n　近頃　身体が　鉄のように重くて……。\n　ボクはもう　長くないのかもしれないな。": ""
  },
  "88685": {
    "「……気弱なことを言うなよ　ツィム。\n　そういや　さっきから姉って　なんのことだ？\n　お前は　俺と同じ　孤児のはずだろ？": ""
  },
  "88686": {
    "「ポチトリ。修道院のみんなには\n　黙ってたけど　ボクには姉がいる。\n　防具鍛冶ギルドの　マスター・リリムだ。": ""
  },
  "88687": {
    "「ボクたち一家…防具鍛冶職人の父さんと\n　姉さん　幼いボクの　３人は\n　岳都ガタラで　幸せに暮らしていた。": ""
  },
  "88688": {
    "「なのに　あの日……！": ""
  },
  "88689": {
    "「姉さんは……マスター・リリムは\n　防具を作るために　ボクの目の前で\n　父さんから命の炎を　奪ったんだ……。": ""
  },
  "88690": {
    "「なっ……！？": ""
  },
  "88691": {
    "「次は　ボクが殺される。\n　逃げようとした　ボクは\n　しかし　そのまま　意識を失い……。": ""
  },
  "88692": {
    "「気が付いたら……\n　姉の姿は　どこにもなく\n　このモガレ修道院に引き取られていた。": ""
  },
  "88693": {
    "「け…けど　いくらなんでも　信じられないよ。\n　ガキの頃の話だろ？　\n　夢か　何かの見間違いってことはないのか？": ""
  },
  "88694": {
    "「あの時のボクは　たしかに子供だった。\n　……でも。": ""
  },
  "88695": {
    "「父さんを殺した　姉の姿は\n　今でも　この目に　焼き付いてる。": ""
  },
  "88696": {
    "「大きくなったボクは　行方知れずの姉を\n　ようやく探しあて　そして　姉が今も\n　命の炎で　防具を作ろうとしていると知った。": ""
  },
  "88697": {
    "「ボクは　もう行くよ。\n　今度こそ　姉を止めなければ……。": ""
  },
  "88698": {
    "「おっ　おい　待てよ！！": ""
  },
  "88699": {
    "「……だいじょうぶかよ　あいつ。\n　あんな身体で………。": ""
  },
  "88700": {
    "「なあ　<pc>さん。\n　あんたは　ツィムの知り合いだろ。\n　何かあったら　あいつを頼むよ……。": ""
  }
}
