{
  "346077": {
    "カレルは　さる遠方の王国に招かれ\n親善試合で　ウデを披露することになりました。": ""
  },
  "346078": {
    "ところが　カレルは　その大切な試合の中で\n誤って　対戦相手の男を\n殺してしまいそうになります。": ""
  },
  "346079": {
    "しかし　すんでのところで\n男はカレルの剣をかわし　勝負は引き分けとなり\n彼は　正体を明かしました。": ""
  },
  "346080": {
    "なんと　男は　その王国の王子\nエルヴィンだったのです。": ""
  },
  "346081": {
    "エルヴィンは　自分をここまで追い詰めた者は\n初めてだと言い　カレルに\n自分の相棒になれと　誘いました。": ""
  },
  "346082": {
    "カレルは　その申し出を受け入れ\n以来　ふたりは　どこに行くにも\n行動を　共にするようになりました。": ""
  },
  "346083": {
    "エルヴィンと　カレルの剣を前にして\nかなう者はなく　ふたりは\nあの魔皇軍の軍勢を　幾度も　退けていきます。": ""
  },
  "346084": {
    "やがて　ふたりは\n国王や王妃　エルヴィンの妹のヴァスタニア姫に\n婚姻することを　告げ……": ""
  },
  "346085": {
    "互いの剣を交差させるように　掲げると\n夫婦となる誓いを　立てました。": ""
  },
  "346086": {
    "王国には　その時の像が建造され\nふたりは　しあわせに　暮らしましたとさ。": ""
  },
  "353569": {
    "……昔　カレルという女性の剣士が\n世に名を馳せていた　時のこと。": ""
  }
}
