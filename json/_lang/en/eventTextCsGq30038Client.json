{
  "120169": {
    "「邪魔するぞ。": ""
  },
  "120170": {
    "「あれ……エイドス老。\n　わざわざ　ここへ　いらっしゃるとは……\n　何か　やっかいな事態でも　起きましたか？": ""
  },
  "120171": {
    "「久しいの　バレクス。\n　ちと　お前のチカラを借りたくてな。": ""
  },
  "120172": {
    "「……ほう　<pc>ではないか。\n　なかなか　よい顔つきになったな。\n　見ちがえたぞ。": ""
  },
  "120173": {
    "「……む？　取り込み中だったか？": ""
  },
  "120174": {
    "「いえ　お気づかいなく。\n　それで　今回　ボクは何をすれば？": ""
  },
  "120175": {
    "「うむ。じつはな……": ""
  },
  "120176": {
    "「……というワケなのじゃ。\n　バレクス　お前の意見を聞かせてくれ。": ""
  },
  "120177": {
    "「……エッ！？　あ　すみません。\n　ちょっと　考えごとをしていて……。\n　もう一度　話してもらえませんか。": ""
  },
  "120178": {
    "「どうしたことじゃ　お前らしくもない。\n　いったい　何があったのだ？": ""
  },
  "120179": {
    "「……つまり　バートルめが　気がかりで\n　上の空というわけか。\n　フン。まだまだ青いな　バレクス。": ""
  },
  "120180": {
    "「恥ずかしながら　その通りですネ……。": ""
  },
  "120181": {
    "「よかろう。では　わしから\n　二度と　おぬしの邪魔をせぬよう\n　バートルに　きつく　命じておこう……。": ""
  },
  "120182": {
    "「やめてください！": ""
  },
  "120183": {
    "「……困っているのは　確かですが\n　バートルは　長年　ボクの家系に\n　仕えてくれた……家族同然の者です……。": ""
  },
  "120184": {
    "「あまり　無理じいは　したくありません。\n　難しいかもしれませんが……なんとか\n　ボクの気持ちをわかってもらえれば……。": ""
  },
  "120185": {
    "「ふむ。おぬしが　そこまで言うならば\n　やめておくことにしよう……。": ""
  },
  "120186": {
    "「む！？　しまった……。\n　ここへ来る途中で　財布を落としたようじゃ！": ""
  },
  "120187": {
    "「すまんが　わしの財布を探してくれんか。\n　なあに　そう手間は取らせぬ。\n　こやつを借りてよいな？　バレクス。": ""
  },
  "120188": {
    "「はぁ……。どうぞ　ご自由に……。\n　それじゃ　<pc>　また後でネ。\n　エイドス老も　ごきげんよう。": ""
  },
  "120189": {
    "「とっくに　気づいておるじゃろうが\n　わしは　財布など　なくしてはおらん。\n　お前を連れ出すための　方便じゃ。": ""
  },
  "120190": {
    "「バレクス……そして　バートルのやつめも\n　わしの　古くからの知り合いでな。\n　あれの頑固さは　よく知っておる。": ""
  },
  "120191": {
    "「……とはいえ　バレクスが　あの調子では\n　わしの方にも　色々と　支障があってな。\n　なんとか　手を打たねばならん。": ""
  },
  "120192": {
    "「そこで　お前の出番じゃ。\n　<pc>。": ""
  },
  "120193": {
    "「オルフェアの町の調理ギルドで\n　賢者エイドスが待っている……\n　そう　バートルに伝え　やつを連れてこい。": ""
  },
  "120194": {
    "「それと　このことは　くれぐれも\n　バレクスには　内密にな。\n　では　頼んだぞ！": ""
  },
  "120195": {
    "「来たな　<pc>。\n　バートルも　しばらく前に　到着したぞ。": ""
  },
  "120196": {
    "「お久しぶりでございます　賢者エイドス様。": ""
  },
  "120197": {
    "「うむ。久しいな　バートルよ。\n　さて……おぬしを　ここへ呼んだのは\n　バレクスの話を　するためじゃ。": ""
  },
  "120198": {
    "「おお　以心伝心とは　このことですな。\n　私もエイドス様に　坊ちゃまのことで\n　お話が……いえ　お願いがございます。": ""
  },
  "120199": {
    "「……そうか。では　わしの用件が\n　終わったあとで　聞くとしよう。": ""
  },
  "120200": {
    "「ポッパー。話してやれ。": ""
  },
  "120201": {
    "「はじめまして！　この調理ギルドの\n　経理を担当している　ポッパーと申します。\n　おいしいごはん　食べてますか？": ""
  },
  "120202": {
    "「いやはや　これは　ごていねいに。\n　なかなか活気のある\n　結構な　ギルドのようですなあ。": ""
  },
  "120203": {
    "「……ありがとうございます。\n　ですが　このギルドが　賑わっているのも\n　マスター・バレクスのおかげなんですよ。": ""
  },
  "120204": {
    "「調理ギルドだけじゃありません。\n　すべての職人ギルドの者は\n　マスター・バレクスに　感謝しています。": ""
  },
  "120205": {
    "「あやつは　自分のことを\n　なかなか語りたがらんからな。\n　知らんで当然じゃろう。": ""
  },
  "120206": {
    "「この　アストルティアで　今のように\n　職人ギルドが　隆盛を極めるようになったのは\n　すべて　バレクスの手柄なのじゃ。": ""
  },
  "120207": {
    "「……坊ちゃまの？": ""
  },
  "120208": {
    "「かつて……バレクスが道具鍛冶ギルドの\n　マスターになる以前のことじゃ。": ""
  },
  "120209": {
    "「仕事の厳しさ　極めるまでの困難さゆえに\n　新人職人は　減少する一方……\n　各職人ギルドは　つぶれる寸前じゃった。": ""
  },
  "120210": {
    "「このままでは　アストルティア全体の\n　産業や　文化が　低迷してしまう。\n　それに最初に気づいたのが　バレクスだ。": ""
  },
  "120211": {
    "「新人職人を増やすための方策として\n　賢者バレクスは　道具鍛冶ギルドに\n　初心者用の道具の　安価な提供を提案した。": ""
  },
  "120212": {
    "「しかし……\n　当時のマスターは　それを断ったのじゃ……。": ""
  },
  "120213": {
    "「……どうじゃ　バレクス。\n　この間　おぬしが言っておった\n　道具鍛冶ギルドとの交渉は？": ""
  },
  "120214": {
    "「……難航中ですネ。\n　というか　キッパリ断られました。": ""
  },
  "120215": {
    "「壊れやすく　価格の安い　初心者用道具の量産は\n　やりがいもなく　利益ももたらさない\n　無駄な仕事……だそうです。": ""
  },
  "120216": {
    "「道具鍛冶の頂点に立つ者には\n　初心者用の道具など　面白い仕事とはいえぬ。\n　そう答えるのも　無理はなかろう。": ""
  },
  "120217": {
    "「今日　明日のことだけを考えるなら\n　それも　ひとつの真理かもしれません。\n　しかし……": ""
  },
  "120218": {
    "「道具職人が作るのは　道具では……ナイ。": ""
  },
  "120219": {
    "「初心者用の道具をはじめ……\n　消耗品として　壊れゆく道具を通じ……\n　１０年後　１００年後の　名職人を作る。": ""
  },
  "120220": {
    "「目先の利に　とらわれず　未来の職人……\n　いや　全職人の未来を作ることこそが\n　道具鍛冶という仕事……と思うのですが。": ""
  },
  "120221": {
    "「では　次の手はどうする？\n　バレクスよ。": ""
  },
  "120222": {
    "「ま……考えがあります。\n　成功確率は……９８．１％。\n　楽しみに　待っていてください。": ""
  },
  "120223": {
    "「……その直後じゃ。\n　バレクスが　道具鍛冶の仕事を学び始めたのは。": ""
  },
  "120224": {
    "「やつは　またたく間に　ウデを磨き\n　聞く耳を持たぬ　道具鍛冶ギルドマスターを\n　追い落としてしまった。": ""
  },
  "120225": {
    "「そして　道具鍛冶マスターとして\n　すべてのギルドに　初心者用の職人道具を\n　無償で提供するシステムを　作り上げたのじゃ。": ""
  },
  "120226": {
    "「なんと……！\n　坊ちゃまが　突然　姿を消したのには\n　そんな理由が　あったのですか……。": ""
  },
  "120227": {
    "「以降　世界の職人総人口は　みるみる増加し\n　職人ギルドは　隆盛を極めるようになった。": ""
  },
  "120228": {
    "「もし　バレクスが\n　道具鍛冶マスターにならなければ\n　この　調理ギルドとて……": ""
  },
  "120229": {
    "「人もろくに　寄りつかず\n　ただ　朽ち果てるのを　待つばかりと\n　なっていたことだろう……。": ""
  },
  "120230": {
    "「のう　バートル。おさなき頃より\n　バレクスを見守ってきた　おぬしならば\n　あやつを信じ　その選択を認めてやれるはず。": ""
  },
  "120231": {
    "「いくらか　才のある者ならば\n　時間さえかければ　賢者には　なれるだろう。": ""
  },
  "120232": {
    "「じゃが　この　職人大革命は\n　バレクスの坊主にしか　できなかった。\n　……まこと　見上げた奴じゃよ。": ""
  },
  "120233": {
    "「おお……バレクス坊ちゃま……。\n　わしは　坊ちゃまに\n　なんという失礼なことを……。": ""
  },
  "120234": {
    "「いそぎ　坊ちゃまに　おわびしなくては。\n　賢者エイドス様　失礼いたしますぞ！": ""
  },
  "120235": {
    "「……さて。これで　バレクスの坊主も\n　心置きなく　道具職人として……\n　また　賢者として　働けるじゃろう。": ""
  },
  "120236": {
    "「<pc>。\n　道具鍛冶ギルドに戻り　バレクスに\n　こう　伝えてくれ。": ""
  },
  "120237": {
    "「今回の貸しの分は　いずれ\n　身を粉にして　働いてもらうぞ……とな。": ""
  },
  "169846": {
    "「……これが　バレクスによる　職人大革命じゃ。": ""
  },
  "169847": {
    "「バートルは　娯楽島ラッカランの\n　教会前に　おるぞ。": ""
  }
}
