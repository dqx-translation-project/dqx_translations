{
  "343308": {
    "「風の神エルドナよ。悪しき風をはらい\n　この地に　清き息吹を　もたらしたまえ。": ""
  },
  "343309": {
    "「……アシノヤ。": ""
  },
  "343310": {
    "「……おお。\n　私のことを　覚えておいでですか……。": ""
  },
  "343311": {
    "「どんなに　時が経とうとも\n　我が弟子を　忘れるはずがない。": ""
  },
  "343312": {
    "「お懐かしゅうございます　師父。\n　この地のケガレを　はらい清めてくださり\n　感謝いたします……。": ""
  },
  "343313": {
    "「……<pc>。およそ６０００年前\n　この地には　サワナギという名の\n　小国が栄えていた。": ""
  },
  "343314": {
    "「しかし　ある時　災厄の王の出現とともに\n　マガツカゼが吹き荒れ　一夜のうちに滅んだ。": ""
  },
  "343315": {
    "「マガツカゼは　人々の命と絶望を食いつくし\n　やがて　醜悪な魔物を生んだ……。\n　これが　マガツタタリカゼだ。": ""
  },
  "343316": {
    "「師父は　王国の生き残りを　弟子にとり\n　ストームカイザーとして　鍛えてくださった。": ""
  },
  "343317": {
    "「私たちは　師父と共に　途方もない苦労を重ね\n　ついに　マガツタタリカゼを\n　谷の底へ　封じることに成功しました。": ""
  },
  "343318": {
    "「今の世があるのは　師父のおかげなのです。\n　感謝しても　しきれませぬ……。": ""
  },
  "343319": {
    "「……だが　あれから幾星霜を重ね\n　マガツタタリカゼの封印は　少しずつ\n　弱まってきている。": ""
  },
  "343320": {
    "「あの時　多くの犠牲を出したというのに。\n　……アシノヤ。おまえも　そのひとり。": ""
  },
  "343321": {
    "「あなたの弟子となって　後悔している者など\n　ひとりもおりません。わたしたちは\n　皆　あなたのことを　慕っていた。": ""
  },
  "343322": {
    "「そして……救ってさしあげたかった……。": ""
  },
  "343323": {
    "「……あなたならば　いつかきっと\n　マガツタタリカゼを　倒すことができる。": ""
  },
  "343324": {
    "<center>信じています……師父。": ""
  },
  "343325": {
    "「かげろうに　溶けて風なる　君の声……。": ""
  },
  "343326": {
    "「私には　エルドナ神に託された　チカラがある。\n　ケガレを断ち切り　封じることができる。\n　大地を清め　結界を張ることもできる……。": ""
  },
  "343327": {
    "「そうして　師父を名乗ってこそいるが\n　弟子たちがいなければ　何もできなかった。": ""
  },
  "343328": {
    "「ひとりでは　何も…………。": ""
  },
  "343329": {
    "「この地のケガレは　はらい清められた。\n　役目を果たしてくれた　ごほうびを渡すよ。\n　草庵へ戻ろう　<pc>。": ""
  }
}
