{
  "139433": {
    "「待っていたぜェ……\n　調理ギルドの天才職人　<pc>さんよォ！": ""
  },
  "139434": {
    "「さあ　決着をつけようじゃねェか！！\n　あんたらの　まごころとかいう　ふぬけ料理と\n　オレ様の禁断の料理　どっちが究極なのかなァ！": ""
  },
  "139435": {
    "「今日のためによォ　特別審査員も\n　呼んでおいてやったぜェェ！": ""
  },
  "139436": {
    "「ったく　こんな場所まで　呼びだしやがって。": ""
  },
  "139437": {
    "「やるからには　公平な審査をさせてもらうぜ。 \n　……調理ギルドの　過去の因縁\n　おめえの手で　終わらせろよ！": ""
  },
  "139438": {
    "「レディース　エーンド　ジェントルメン！\n　これより　料理対決を開始するぜ！！": ""
  },
  "139439": {
    "<pc>は　エンジェルクリームを\nたまごに　溶かしこんだ！": ""
  },
  "139440": {
    "<pc>は　あいじょうオムレツを\nみごとに　完成させた！": ""
  },
  "139441": {
    "「見てなァ！！\n　この　なんの面白味もない　オムレツに……": ""
  },
  "139442": {
    "「デビルパウダーを　オン　アンド　オンで\n　激情オムレツの　完成だぜェ！！\n　さあ　オレ様の究極の料理　食ってみなァ！！": ""
  },
  "139443": {
    "「こ　これはぁぁ……！！": ""
  },
  "139444": {
    "「舌をガツンとやられる　強烈なスパイス！ \n　腹の底から　奇妙なチカラが\n　ムクムク　せりあがってきやがる……！": ""
  },
  "139445": {
    "「し…しかも　心臓がバクバクして早鐘のようだ。\n　この胸のビート……　まさに　激情の料理！\n　さすが　調理ギルドを滅ぼしただけあるぜ。": ""
  },
  "139446": {
    "「料理ってのは　アルティメットなパワーだぜェ！\n　あんたの　しみったれた生き様も\n　今日！　この時から！　変えてやんよォ！！": ""
  },
  "139447": {
    "「くっ……。\n　クッキングデビル……あなどれねぇ……。\n　調理ギルドのほうは　どうなんだ！？": ""
  },
  "139448": {
    "<pc>は　あいじょうオムレツを\n審査員に　提出した！": ""
  },
  "139449": {
    "「まさか　オムレツ同士の対決になるとはな……。 \n　さっそく　いただくぜ。": ""
  },
  "139450": {
    "「な　なにいぃぃ……！！": ""
  },
  "139451": {
    "「デビルの料理によって　引き起こされた \n　心臓のビートが　おさまっていく……。\n　その代わりに……": ""
  },
  "139452": {
    "「いやしの甘みで　心が満たされていく……。\n　デビル料理で得た　活力と合わされば……": ""
  },
  "139453": {
    "「心も身体も　至上の幸福感……！ \n　俺は今　誰にも負ける　気がしねえ……。": ""
  },
  "139454": {
    "「おめえも　ひとくち食べてみな。": ""
  },
  "139455": {
    "「ケッ。こんな　おちゃらけた料理……": ""
  },
  "139456": {
    "「………………クッキンドリーム。": ""
  },
  "139457": {
    "「未知のチカラを引きだす　デビルパウダーと \n　心身をいやす　エンジェルクリーム……": ""
  },
  "139458": {
    "「その　ふたつが　合わさった時……\n　料理は　現実を超えた　ドリームになるんだ！！": ""
  },
  "139459": {
    "「料理で　人を　幸せにする……。\n　これが……　お父さんの目指した夢なんだね。": ""
  },
  "139460": {
    "「やっぱり　おめえだったんだな……ポシェル。": ""
  },
  "139461": {
    "「あっ　あれ……？\n　<pc>さん……。町長さん……。\n　あたし……どうして…………？": ""
  },
  "139462": {
    "「そうだった……。 \n　あたしは　調理ギルドのマスターになってから\n　お父さんを　理解しようと思って……": ""
  },
  "139463": {
    "「禁断の料理を作って　食べちゃったんだ……。": ""
  },
  "139464": {
    "「なるほど　そういうことか……。": ""
  },
  "139465": {
    "「ポシェル……おめえは　調理ギルドマスターを \n　引き受けることになってから　ずっと\n　クッキングデビルの影に　おびえてきた。": ""
  },
  "139466": {
    "「いっぽうで　おめえは…… \n　自分の父親を　どこか　心の片隅で\n　否定しきれないで　いたんだな。": ""
  },
  "139467": {
    "「そんな　おめえの心の矛盾が \n　禁断の料理のパワーと　反応して\n　デビルの亡霊を　よみがえらせちまったんだ。": ""
  },
  "139468": {
    "「……無意識のうちに　自ら演じることでな。": ""
  },
  "139469": {
    "「あたし……本当に　ごめんなさい……。 \n　調理ギルドを　裏切っちゃった。\n　こんなんじゃ……マスター　失格だね。": ""
  },
  "139470": {
    "「甘えな……。砂糖菓子のように　甘え……。\n　俺は　デビルじゃねえが　あえて言うぜ。": ""
  },
  "139471": {
    "「あいつの夢から　おめえが逃げてどうする！\n　おめえが　あいつの夢を　継いでみせろ！！": ""
  },
  "139472": {
    "「でも……": ""
  },
  "139473": {
    "「それに　おめえのもとで　<pc>のような\n　神がかった調理職人が　育ってくれたこと\n　俺には　必然だったように　思えるんだ。": ""
  },
  "139474": {
    "「おめえが　今回の勝負を挑んだのは \n　<pc>なら　デビルが　到達できなかった\n　答えを見せてくれると　信じたからじゃないか？": ""
  },
  "139475": {
    "「そんな調理職人の素質を　見出し\n　正しく育てられた　おめえになら…… \n　俺は　マスターを続けてほしいと　思うぜ。": ""
  },
  "139476": {
    "「……はいっ！！": ""
  },
  "139477": {
    "「<pc>さんは　お父さんが目指した\n　究極の料理に　たどり着いてくれた……。\n　あたしより　ずっとすごい職人さんだよ……！": ""
  },
  "139478": {
    "「<pc>さん。\n　あたしの目を　覚まさせてくれて\n　本当に　ありがとうございました！": ""
  },
  "139479": {
    "「それにしても　<pc>……見事だったぜ。 \n　おめえさん　すでに　エンジェルやデビルすらも\n　超えた料理人なんじゃねえか。": ""
  },
  "139480": {
    "「もしかしたら　<pc>さん　そのものが\n　クッキンドリームなのかもしれないねっ！": ""
  },
  "139481": {
    "「この料理対決……<pc>の勝利だ！": ""
  },
  "139482": {
    "「<pc>さん！\n　調理ギルドに戻ったら　たくさん\n　ごめんなさいと　お礼をさせてねっ！！": ""
  },
  "165775": {
    "「激情と愛情が　合わさって……\n　こいつは　まさに　極上オムレツだぜ！": ""
  },
  "168229": {
    "調理職人や　村人たちが集まり　見守る中\nついに　料理対決が　始まった！": ""
  }
}
