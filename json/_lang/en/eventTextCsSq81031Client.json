{
  "346512": {
    "なんと　キュララナビーチで\nムーロンとメローラの　結婚式が\n執りおこなわれた！": ""
  },
  "346513": {
    "まぶしく輝く　太陽の下で　\nふたりは　永遠の愛を誓い\n新しく生まれた夫婦を　皆が祝福した。": ""
  },
  "346514": {
    "そして……": ""
  },
  "346515": {
    "「……水温よし。しびれくらげ　なし。\n　サメバーンの姿も……見えないな。": ""
  },
  "346516": {
    "「ムーロンさん。問題なさそうっス！": ""
  },
  "346517": {
    "「まどろっこしいのは　ナシだぜ。\n　スリルとロマンスの夏は　唐突に始まる……。": ""
  },
  "346518": {
    "「ゴウレ！　若者たちに告げな！": ""
  },
  "346519": {
    "「この夏　最大の青春が\n　大グチ開けて　待ってるってなぁ！": ""
  },
  "346520": {
    "「よぉーっし！　お前たち！\n　準備体操は　終わっているか！？\n　お待ちかねの　海開きの時間だぞぉっ！": ""
  },
  "346521": {
    "「サイッコーの　ながめだぜ……。\n　やっぱり　キュララナビーチの夏は　格別だな。": ""
  },
  "346522": {
    "「おいおい　また　その写真か？\n　そんなに見てると　穴があいちまうぞ。": ""
  },
  "346523": {
    "「ふふっ　だって……うれしいんですもの。\n　こうして　あなたと　一緒になれて……\n　皆さまに　祝福してもらえて　夢みたい。": ""
  },
  "346524": {
    "「ああ……　いい式だったよな。": ""
  },
  "346525": {
    "「オレとお前には　この先\n　そんなに長い時間は　残されていない。\n　だが　乗り越えにゃならん苦難は　山ほどある。": ""
  },
  "346526": {
    "「けどよ……　それが人生ってもんだ！\n　荒波を乗り越えた先に　輝くお宝が待ってる。\n　お前という宝に出会えて　オレは本当に幸せだ。": ""
  },
  "346527": {
    "「病めるときも　健やかなるときも……\n　死がふたりを別つまで　共にありましょう。\n　このキュララナの海で……。": ""
  },
  "346536": {
    "「あなたは　もしかして……　ムーロン様っ！\n　助けに　きてくださったのですね！": ""
  },
  "346537": {
    "「メローラ……　すまねえな。\n　オレが　ここまで来たのは　お前に\n　言わなくちゃならないことが　あるからなんだ。": ""
  },
  "346538": {
    "「オレとお前は　もう会うわけにはいかねえ。\n　今日は　それだけ　告げにきたんだ。": ""
  },
  "346539": {
    "「えっ……　ムーロン様……？": ""
  },
  "346540": {
    "「オレは　お前のことを　大事に思ってる。\n　その気持ちに　偽りはねえ……。\n　だがよ…………": ""
  },
  "346541": {
    "「この恋は　お前を　不幸にしちまう。\n　親父さんも　おふくろさんも　お前に\n　傷ついてほしくなくて　反対してくれてるんだ。": ""
  },
  "346542": {
    "「オレだって　お前が　みすみす\n　不幸せになるのなんか　見たくねえ。\n　だから……お前の人生から　去ることにするぜ。": ""
  },
  "346543": {
    "「あばよ　メローラ……。": ""
  },
  "346544": {
    "「……なによ　それ……。": ""
  },
  "346545": {
    "「どうして……　どうして……\n　他でもない　あなたが　そんなことを言うの？\n　ムーロン様の……": ""
  },
  "346546": {
    "「ムーロン様の　バカーーーーッッッ！！": ""
  },
  "346547": {
    "「メローラの怒りに　海が共鳴しておる……！？\n　我が娘に　これほどまでのチカラが\n　受け継がれていようとは……。": ""
  },
  "346548": {
    "「どうしてみんな　私の幸せを　勝手に決めるの？\n　生きる世界が違うことも　寿命の差があることも\n　わかってるに　決まってるじゃない！": ""
  },
  "346549": {
    "「でも　どんなに苦しくても　共にいられる時間が\n　短くても　私には　ムーロン様だけなの！\n　……私の愛を　バカにしないでッッ！！": ""
  },
  "346550": {
    "「いかん！　このままでは\n　海の世界が　すべて　吹き飛ばされてしまう！\n　メローラ自身も　無事ではすまぬぞ……。": ""
  },
  "346551": {
    "「なんてこった……ちくしょう！\n　オレは　ホレた女を　不幸にすることしか\n　できねえってのかよ……。": ""
  },
  "346552": {
    "「そいつは　オレが　メローラに渡そうとしていた\n　指輪じゃないか！　遠い昔に\n　キュララナビーチに　埋めたはずなのに……。": ""
  },
  "346553": {
    "「……覚悟を　決めろってことか。\n　わかったよ。": ""
  },
  "346554": {
    "「……メローラ　メローラぁッ！\n　頼む　聞いてくれ……ッ！": ""
  },
  "346555": {
    "「オレは　お前の幸せを願って　身を引いた！\n　オレといることで　お前に　たくさん\n　悲しい想いをさせることに　なるからだ……。": ""
  },
  "346556": {
    "「オレも　正直　怖いし　つれえよ……！\n　だけどよ……　お前が　愛してくれるってんなら\n　オレも　自分の気持ちに　もうウソはつかねえ！": ""
  },
  "346557": {
    "「愛してるッ　メローラ！\n　お前の人生を　オレにくれ！\n　この海で死ぬまで　共に生きようッ！": ""
  },
  "346558": {
    "「ムーロン様……っ！": ""
  },
  "346559": {
    "「ずっと　ずっと　こうなりたかった。\n　私は　あなたの伴侶として\n　この先の人生を　歩んでいくのですね。": ""
  },
  "346560": {
    "「ああ……　お前は人魚　オレはウェディ。\n　別の種族のまま　一緒になるんだ。\n　悲しみも　苦しみも　共に乗り越えていこう。": ""
  },
  "346561": {
    "「すべて　承知の上か……。\n　そこまで　覚悟ができているのなら　もはや\n　何も言うことはない。陸の者よ　娘を頼んだぞ。": ""
  },
  "346562": {
    "「メローラ……　私のかわいい娘よ。\n　どうか　幸せにおなり。": ""
  },
  "346563": {
    "「へへっ……　なんだか　こそばゆいぜ。\n　お前さんには　ずいぶんと\n　世話になっちまったな。": ""
  },
  "346564": {
    "「さあ　キュララナビーチへ　帰るとするか。\n　戻ったら　お待ちかねの海開きだぞ！": ""
  }
}
